<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportHeight="108"
    android:viewportWidth="108">
    
    <!-- Outer Shield Contour -->
    <path
        android:pathData="M54,16 L88,34 L88,72 L54,92 L20,72 L20,34 Z"
        android:strokeColor="#06b6d4"
        android:strokeWidth="3.5"
        android:strokeLineJoin="round"
        android:fillColor="#0c1f38" />

    <!-- Inner Shield Grid Accent -->
    <path
        android:pathData="M54,23 L80,38 L80,68 L54,83 L28,68 L28,38 Z"
        android:strokeColor="#0891b2"
        android:strokeWidth="1.2"
        android:fillColor="#081426" />

    <!-- Dynamic Glowing Lightning Bolt -->
    <path
        android:pathData="M60,28 L34,55 L50,55 L46,80 L74,48 L58,48 Z"
        android:strokeColor="#ffffff"
        android:strokeWidth="1.5"
        android:strokeLineJoin="round">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="30"
                android:endX="70"
                android:endY="80"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#22D3EE" android:offset="0.4" />
                <item android:color="#0284C7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
